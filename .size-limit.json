[
  {
    "name": "Initial JS (entry and the chunks it shares with the content)",
    "path": [
      "dist/assets/*.js",
      "!dist/assets/hero-scene-runtime-*.js",
      "!dist/assets/desktop-enhancements-*.js",
      "!dist/assets/home-journey-*.js",
      "!dist/assets/site-content.*.js"
    ],
    "limit": "125 kB"
  },
  {
    "name": "French content (preloaded, awaited before hydration)",
    "path": "dist/assets/site-content.fr-*.js",
    "limit": "9 kB"
  },
  {
    "name": "English content (preloaded, awaited before hydration)",
    "path": "dist/assets/site-content.en-*.js",
    "limit": "9 kB"
  },
  {
    "name": "Hero scene (WebGL, loaded on idle, large screens only)",
    "path": "dist/assets/hero-scene-runtime-*.js",
    "limit": "4 kB"
  },
  {
    "name": "Desktop touches (cursor, decoding texts; loaded on idle, precise pointers only)",
    "path": "dist/assets/desktop-enhancements-*.js",
    "limit": "2 kB"
  },
  {
    "name": "Journey (loaded as hydration reaches it)",
    "path": "dist/assets/home-journey-*.js",
    "limit": "16 kB"
  },
  {
    "name": "CSS",
    "path": "dist/assets/*.css",
    "limit": "15 kB"
  }
]
